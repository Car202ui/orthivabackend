# Copy to .env (same folder) before running `docker compose up`.
# Development-only credentials. Never use these in production.

# PostgreSQL (also hosts the `keycloak` database, created by postgres/init.sql)
POSTGRES_USER=orthiva
POSTGRES_PASSWORD=orthiva_dev
POSTGRES_DB=orthiva
POSTGRES_PORT=5433

# MinIO (S3-compatible object storage)
MINIO_ROOT_USER=orthiva
MINIO_ROOT_PASSWORD=orthiva_dev_minio
MINIO_BUCKET=orthiva-media
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Redis
REDIS_PORT=6379

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8180

# Mailpit (dev SMTP sink)
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
